# =============================================================================
# MaliScan AI — environment (copy to .env on the server; NEVER commit real values)
# Server-side secrets are only read by the API/worker containers.
# NEXT_PUBLIC_* values are public by design (embedded in the browser bundle).
# =============================================================================

# ---- Domains / URLs -----------------------------------------------------------
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
PUBLIC_APP_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=["https://app.example.com"]
ENVIRONMENT=production
LOG_LEVEL=INFO

# ---- Database -------------------------------------------------------------------
# Supabase: Project Settings → Database → direct connection (port 5432, SSL).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# Only with `docker compose --profile selfhosted-db` (bundled PostgreSQL):
POSTGRES_PASSWORD=

# ---- Supabase Auth --------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Legacy JWT secret (HS256). Leave empty if the project uses asymmetric signing keys (JWKS).
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ---- File storage ---------------------------------------------------------------
# supabase: private buckets "documents" and "exports" (create them, keep them PRIVATE)
# local:    files on the `storage` Docker volume; downloads via HMAC-signed links
STORAGE_BACKEND=supabase
SUPABASE_SERVICE_ROLE_KEY=
# HMAC key for signed download links (≥ 32 random chars: `openssl rand -hex 32`)
SIGNING_SECRET=
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=15728640

# ---- AI / OCR -------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
# none | google_vision  (optional OCR pre-pass; assess KVKK first — docs/SECURITY_KVKK.md)
OCR_PROVIDER=none
GOOGLE_VISION_API_KEY=
REVIEW_CONFIDENCE_THRESHOLD=0.85

# ---- Worker / maintenance -------------------------------------------------------
WORKER_POLL_SECONDS=2
# Set to 1 only after reviewing a dry-run report (docs/SECURITY_KVKK.md §Retention)
RETENTION_EXECUTE=

# ---- Backups (backup service) ---------------------------------------------------
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=30
# 1 only for self-hosted auth; Supabase auth is covered by Supabase backups/PITR
BACKUP_INCLUDE_AUTH_USERS=0
# Optional off-site copy, e.g.: rclone copy {file} s3remote:maliscan-backups
BACKUP_REMOTE_CMD=

# ---- Web build (public) ---------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
