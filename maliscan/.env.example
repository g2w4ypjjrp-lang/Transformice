# ---------------------------------------------------------------------------
# MaliScan AI — environment variables (copy to .env, never commit real values)
# ---------------------------------------------------------------------------

# development | test | staging | production  (production disables /docs)
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL connection of the schema owner role.
# Supabase: Project Settings → Database → Connection string (direct, port 5432)
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/maliscan
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Supabase Auth. Provide SUPABASE_URL (JWKS / asymmetric signing keys) and/or
# the legacy JWT secret (HS256). Both are server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- Used from later milestones (declared now so deployments are prepared) ---
# SUPABASE_SERVICE_ROLE_KEY=      # M3: storage signed URLs (backend only)
# ANTHROPIC_API_KEY=              # M4: Claude extraction (backend only)
# OCR_PROVIDER=                   # M4
